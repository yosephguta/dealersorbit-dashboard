# Point the dashboard at a specific API root.
# Leave UNSET in dev — the Vite proxy (vite.config.js) forwards /api → http://localhost:8000,
# so the browser talks same-origin and there's no CORS involved.
# For a hosted build, set this to the real API root:
# VITE_API_BASE=https://api.dealersorbit.com/api/v1
